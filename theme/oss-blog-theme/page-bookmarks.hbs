{{!< default}}

{{!-- Custom page template for /bookmarks/ — Article Bookmark / Read-Later List --}}

<main id="site-main" class="site-main">
    <div class="bookmarks-page">
        <header class="bookmarks-page-header">
            <h1 class="bookmarks-page-title">我的收藏</h1>
            <p class="bookmarks-page-subtitle">稍后阅读 · 本地存储 · 无需登录</p>
        </header>

        <div class="bookmarks-empty" data-bookmarks-empty>
            <div class="bookmarks-empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </div>
            <p class="bookmarks-empty-text">还没有收藏任何文章</p>
            <p class="bookmarks-empty-hint">打开任意文章，点击标题旁的「收藏」按钮即可加入列表</p>
        </div>

        <div class="bookmarks-list" data-bookmarks-list>
            {{!-- Bookmark cards are rendered by assets/js/bookmark.js from localStorage --}}
        </div>
    </div>
</main>
